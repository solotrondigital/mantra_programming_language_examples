# Review Domain Model Entity

class Review:
    def __init__(self, id: Int, movie_id: Int, user_id: Int, rating: Float, body: String = "", username: String = ""):
        self.id = id
        self.movie_id = movie_id
        self.user_id = user_id
        self.rating = rating
        self.body = body
        self.username = username

    def to_json(self) -> String:
        return "{\"id\":" + str(self.id) + ",\"movie_id\":" + str(self.movie_id) + ",\"rating\":" + str(self.rating) + ",\"body\":\"" + self.body + "\",\"username\":\"" + self.username + "\"}"
